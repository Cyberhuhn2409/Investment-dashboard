# ─────────────────────────────────────────────────────────────────────────────
# Signal – Umgebungsvariablen
# Kopieren nach .env.local und nur ausfüllen, was du nutzen willst.
# Ohne Schlüssel läuft Signal vollständig auf deterministischen Demo-Daten.
# Alle Schlüssel werden ausschließlich serverseitig gelesen (kein NEXT_PUBLIC_).
# ─────────────────────────────────────────────────────────────────────────────

# ── Kurse & Kennzahlen ───────────────────────────────────────────────────────
# Finnhub (https://finnhub.io) – Echtzeit-Kurs, Kennzahlen, News für US-Werte.
# Gratis: 60 Aufrufe/Min. Kerzen & Social Sentiment sind Premium (nicht genutzt).
FINNHUB_API_KEY=
# FINNHUB_RPM=55

# Twelve Data (https://twelvedata.com) – Tageshistorie (5 J.), Intraday, ETF-Indizes.
# Gratis: 8 Credits/Min., 800/Tag, nur US. Attribution wird automatisch angezeigt.
TWELVEDATA_API_KEY=
# TWELVEDATA_RPM=8
# TWELVEDATA_RPD=800
# Bezahltarif mit XETRA-Zugang:
# TWELVEDATA_XETRA=true

# Alpha Vantage (https://www.alphavantage.co) – XETRA-Tageskurse (.DEX), News.
# Gratis: 25 Anfragen/Tag, 5/Min. → nur ergänzend (24 h Cache).
ALPHAVANTAGE_API_KEY=
# ALPHAVANTAGE_RPM=5
# ALPHAVANTAGE_RPD=25

# ── Social ───────────────────────────────────────────────────────────────────
# ApeWisdom (https://apewisdom.io) – Reddit-/4chan-Erwähnungen je US-Ticker.
# Kein Schlüssel nötig; opt-in, da externer Dienst ohne Vertrag. Abruf max. alle 15 Min.
APEWISDOM_ENABLED=false
# APEWISDOM_PAGES=5

# Reddit (nur mit eigenen, freigegebenen OAuth-Zugangsdaten – Reddit Data API Terms).
# App anlegen: https://www.reddit.com/prefs/apps (Typ "script"/"web"), Zugang beantragen.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Pflichtformat laut Reddit: <plattform>:<app-id>:<version> (by /u/<name>)
REDDIT_USER_AGENT=
# REDDIT_RPM=90

# ── KI-Zusammenfassungen (optional) ──────────────────────────────────────────
# Anthropic Claude API – deutsche Zusammenfassung der Top-Diskussionen + Stimmung je Beitrag.
# Ohne Schlüssel: regelbasierte Lexikon-Analyse.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_RPM=20

# ── Betrieb ──────────────────────────────────────────────────────────────────
# Fehlende Quellen (z. B. XETRA im Gratis-Tarif) mit gekennzeichneten Demo-Daten auffüllen?
# ALLOW_MOCK_FALLBACK=true
# Speicherort für die Erwähnungs-Historie (ApeWisdom-Basislinie):
# DATA_DIR=.data

# Nur Demo-Modus: Zeit einfrieren (reproduzierbare Screenshots/Tests) …
# MOCK_NOW=2026-09-23T18:30:00Z
# … und Zustände simulieren: stale | error
# MOCK_SCENARIO=
